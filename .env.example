# ==============================================================================
# JAV Staff Leave Portal - Environment Configuration
# Target Domain: https://leave.jaynepal.org
# Timezone: Asia/Kathmandu
# ==============================================================================

# Database Connection (PostgreSQL for Production, SQLite or Postgres for local dev)
# Production PostgreSQL example:
# DATABASE_URL="postgresql://jav_admin:SuperSecretPassword123!@localhost:5432/jav_leave_db?schema=public"
# Local development SQLite default:
DATABASE_URL="file:./dev.db"

# Application Base URL
APP_URL="https://leave.jaynepal.org"
NEXT_PUBLIC_APP_URL="https://leave.jaynepal.org"

# App Timezone
APP_TIMEZONE="Asia/Kathmandu"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
JWT_SECRET="jaynepal-action-volunteers-production-super-secret-key-32-chars-min"

# Optional Supabase integration keys (if using managed Supabase)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

